<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="forme_juridique_view_form" model="ir.ui.view">
        <field name="name">forme.juridique.view.form</field>
        <field name="model">forme.juridique</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="forme_juridique_view_tree" model="ir.ui.view">
        <field name="name">forme.juridique.view.tree</field>
        <field name="model">forme.juridique</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

   <menuitem id="account_report"
              parent="account.menu_finance"
              name="Rapports"
              groups="account.group_account_user"
              
              /> 
    <menuitem id="account_report_audit"
              parent="account_report"
              name="Rapports d'audit"
              groups="account.group_account_user"
              sequence="10"
              
              />


    <menuitem id="account_report_partner"
              parent="account_report"
              name="Rapports des partenaires"
              groups="account.group_account_user"
              sequence="11"
              
              />

    <menuitem id="account_report_declaration"
              parent="account_report"
              name="Déclarations"
              groups="account.group_account_user"
              sequence="12"
              
              />   


</odoo>
