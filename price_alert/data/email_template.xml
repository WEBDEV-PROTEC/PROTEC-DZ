<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="email_template_price_change_report" model="mail.template">
      <field name="name">Product Price Change Alert</field>
      <field name="model_id" ref="product.model_product_template"/>
      <field name="subject">🔔 ${ctx['changed_count']} Product(s) Changed Price</field>
      <field name="email_from">${(user.email or 'noreply@example.com')}</field>
      <field name="email_to">admin@example.com</field>
      <field name="auto_delete" eval="True"/>
      <field name="body_html" type="html">
        <![CDATA[
          <p>Bonjour,</p>
          <p>Les produits suivants ont changé de prix :</p>
          <ul>
            % for p in ctx['products']:
              <li>${p.name}: ${p.last_checked_price} → ${p.list_price} €</li>
            % endfor
          </ul>
          <p>Cordialement,<br/>Webdev</p>
        ]]>
      </field>
    </record>
  </data>
</odoo>
