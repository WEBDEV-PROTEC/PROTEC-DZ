<odoo>
    <template id="delivery_histories" name="Delivery History Table">
        <t t-call="website.layout">
            <style>
                .package-picked-up-tag {
                    background-color: yellow;
                    color: black;
                }
                .in-transit-tag {
                    background-color: gray;
                    color: white;
                }
                .out-for-delivery-tag {
                    background-color: orange;
                    color: black;
                }
                .delivered-tag {
                    background-color: green;
                    color: white;
                }
            </style>
            <div class="oe_structure">
                <div class="container">
                    <center><h3>Delivery History</h3></center>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Event</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="delivery_history" t-as="entry">
                                <tr>
                                    <td><t t-esc="entry['date']"/></td>
                                    <td>
                                        <span t-att-class="entry['event'].replace(' ', '-').lower() + '-tag'">
                                            <t t-esc="entry['event']"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>
