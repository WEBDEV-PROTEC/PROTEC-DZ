<?xml version="1.0" encoding="utf-8"?>
<odoo>    
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.sh_shop_qty</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="website_sale.res_config_settings_view_form" />
            <field name="arch" type="xml">
                    <block id="website_shop_checkout" position="after">
                        <block title="Multiples of Quantity in Shop" id="sh_shop_qty_block">

                            <setting>
                                <field name="multi_website_moq"/>
                            </setting>
                            <setting>
                                <field name="sh_enable_multiple_qty_in_Backend_sale_order"/>
                            </setting>

                        </block>                    
                    </block>
                   
            </field>
        </record>
    

</odoo>
