<odoo>
    <data>
        <template id="custom_batch_payment_report" inherit_id="account_batch_payment.print_batch_payment">
            <xpath expr="//div[@class='page page_batch_payment'][1]" position="replace">
                <div t-if="page['journal_name'] == 'AGB Agence Oran'"  t-foreach="pages(o)" t-as="page" class="page page_batch_payment"  style="padding-top: 0; margin-top:0">
                    <style>
                        .check {
                        margin-left: 5px;
                        height: 24px;
                        width: 24px;
                        border: 3px solid #005187;
                        display: inherit;
                        /* align-self: center; */
                        top: 5px;
                        position: relative;
                        }
                        th {
                        background-color: #cce0ed !important; 
                        text-align: center;
                        font-size: 12px;
                        }
                        td {
                        font-size: 12px;
                        padding: 2px !important
                        }
                        table, th, td {
                        border: 1px solid #005187 !important;
                        }
                    </style>
                    <div>
                        <div class="row mb-5"  style="padding-top: 0; margin-top:0">
                            <div class="col-6"  style="padding-top: 0; margin-top:0">
                                <img src="/batch_payment_pdf/static/download.png" alt="" style="height: 64px;"/>
                                <!--                                <img src="/batch_payment_pdf/static/protec.png" alt="" style="height: 64px;"/> -->
                            </div>
                            <div class="col-6 text-center">
                                <h4 style="color: #005187"> تسليم صكوك</h4>
                                <h4 style="color: #005187">REMISE DE CHEQUES</h4>
                            </div>
                            <!--<div class="col-12 col-lg-4 col-md-4">
                                <span class="p-2">
                                    <h6 style="color: #005187;">
                                        <t t-esc="page['journal_name']"/>
                                        : 
                                        <t t-esc="page['batch_name']"/>
                                    </h6>
                                </span>
                                </div> -->
                        </div>
                        <div class="row">
                            <div class="col-9">
                                <div class="row">
                                    <div class="col-12 col-lg-12 col-md-12">
                                        <div class="row">
                                            <div class="col-6 col-lg-6 col-md-6">
                                                <label for=""> <b>ENCAISSEMENT</b> 
                                                <span class="check"> <i style="top: -9px; position: relative" class="fa fa-check fa-2x"></i></span>
                                                </label>
                                            </div>
                                            <div class="col-6 col-lg-6 col-md-6">
                                                <label for=""> <b>ESCOMPTE</b>
                                                <span class="check"> </span>
                                                </label>
                                            </div>
                                        </div>
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th class="text-left">
                                                        مؤسسة الدفع<br/>
                                                        Etablissement payeur
                                                    </th>
                                                    <th class="text-left">
                                                        مكان الدفع
                                                        <br/>Lieu de payment
                                                    </th>
                                                    <th class="text-left">اسم الساحب<br/>Nom de tireur</th>
                                                    <th class="text-left">رقم الصك<br/>N° de Chéque</th>
                                                    <th class="text-right">المبلغ<br/>Montant</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="page['payments']" t-as="payment">
                                                    <td class="text-left">
                                                        <t t-if="payment.cheq_bank" t-esc="payment.cheq_bank"/>
                                                    </td>
                                                    <td class="text-left">
                                                        <t t-if="payment.cheq_place" t-esc="payment.cheq_place"/>
                                                    </td>
                                                    <td class="text-left">
                                                        <t t-if="payment.cheq_name"  t-esc="payment.cheq_name"/>
                                                    </td>
                                                    <td class="text-left">
                                                        <t t-if="payment.cheq_num" t-esc="payment.cheq_num"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <t t-esc="payment.amount" t-options="{'widget': 'monetary', 'display_currency': payment.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                            <tfoot t-if="page['total_amount']">
                                                <tr>
                                                    <td style="visibility: hidden;" />
                                                    <td style="visibility: hidden;" />
                                                    <td style="visibility: hidden;" />
                                                    <td><b>Montant total</b></td>
                                                    <td class="text-right">
                                                        <span>
                                                            <t t-esc="page['total_amount']" t-options="{'widget': 'monetary', 'display_currency': page['currency']}"/>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                                <div class="row mt-5">
                                    <div class="col-12 col-lg-6 col-md-6" >
                                        <b>
                                            Nombre de cheques:
                                            <t t-esc="len(page['payments'])"/>
                                        </b>
                                    </div>
                                    <hr/>
                                </div>
                                <div class="row">
                                    <div class="col-12 col-lg-12 col-md-12">
                                        <b>
                                            Date: 
                                            <t t-esc="page['date']"/>
                                        </b>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3" style="margin-top: 30px;">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th scope="col">
                                                الاسم أو الغرض الاجتماعي <br/>
                                                Nom ou raison sociale
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td scope="row"> <br/>SARL PROTEC IMPORT/EXPORT<br/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th scope="col">العنوان Adresse</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td scope="row">70 Avenue Mustapha Ben Boulaid (Ex Albert 1er) Oran 31000</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th scope="col">رقم الحساب N° de compte</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td scope="row"><br/>0357.5912.08-01<br/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!--END/ -->
                    </div>
                </div>
                <div t-if="page['journal_name'] == 'BEA Agence Oran-60'" t-foreach="pages(o)" t-as="page" class="page page_batch_payment" style="padding-top: 0; margin-top:0; color: #0E46A3; font-family: 'Times New Roman', serif !important;">
                    <style>
                        .adress-box {
                            border: 2px solid #0E46A3;
                            border-radius: 16px;
                            padding: 8px;
                            color: #222 !important;
                        }
                        .bg-gray {
                            background-color: #eee;
                            height: 64px;
                            width: 90%;
                            margin-bottom: 8px;
                            padding: 8px;

                        }
                        .text-amount {
                            font-weight: bold;
                            font-size: 16px !important;
                            color: #222 !important;
                        }
                        th {
                            text-align: center;
                            font-size: 12px;
                            padding: 4px !important;
                        }
                        .cheq-line {
                            font-size: 13px;
                            padding: 4px !important;
                        }
                        .serif-font: {
                            font-family: 'Times New Roman', serif !important;
                        }
                        .text-bold {
                            font-weight: bold;
                        }
                        
                    </style>
                    <div class="row mb-5 serif-font"  style="padding-top: 0; margin-top:0:">
                        <div class="col-12 text-left">
                            <h4 style="color: #0E46A3;" class="serif-font">BORDERAU des CHEQUES payables SUR............................................</h4>
                            <h4 style="color: #0E46A3;" class="serif-font">remis à la Banque Extérieur d'Algérie, le ...................................</h4>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            <div class="row">
                                <div class="col-12">
                                    <br />
                                    <br />
                                    <br />
                                    <span class="float-right serif-font">
                                        <h4>Par:</h4>
                                        <h4>Cpte N°</h4>
                                    </span>
                                </div>
                            </div>

                            <div class="row">
                            <hr />
                            <div class="d-block">
                                <br />
                                <p class="text-left serif-font text-bold" style="text-wrap: balance;">
                                    NB - La BANQUE EXTERIEURE
                                    D'ALGERIE déclien toute
                                    responsabilté au cas oû la
                                    présentation et la protêt des
                                    chèques n'auraient pu être fait dans
                                    les délais impartis par la loi
                                </p>
                            </div>
                         </div>
                        </div>
                        <div class="col-8 serif-font">
                            Numéro de compte - Nom et Adresse ou Cachet de la maison ou empreinte ADREX
                            <div class="adress-box serif-font" style="font-weight: bold;" >
                                <br />
                                SARL PROTEC IMPORT/EXPORT <br />
                                70 Avenue Mustapha Ben Boulaid (Ex Albert 1er) Oran 31000<br/>
                                cpte : 606 386 - 54<br/>
                                <br />
                                <br />
                                <br />
                                <br />
                                <br />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                             <br />
                            <p style="margin: 16px 0" class="serif-font">
                                <b>Dont le montant est à porter au CREDIT de son compte et sera disponible seulement après encaissement définitif des dits chèques.</b></p>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th colspan="2" class="text-center serif-font">
                                            ETABLISSEMENTS PAYEURS
                                        </th>
                                        <th rowspan="2" class="text-center serif-font">
                                            SOMMES
                                        </th>
                                    </tr>
                                    <tr>
                                        <th class="text-center serif-font">NOMS</th>
                                        <th class="text-center serif-font">ADRESSES</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="page['payments']" t-as="payment" style="color: #222 !important; font-weight: bold;">
                                        <td class="text-left cheq-line serif-font">
                                            <t t-if="payment.cheq_name"  t-esc="payment.cheq_name"/> 
                                        </td>
                                        <td class="text-left cheq-line serif-font">
                                            <!-- <t t-if="payment.cheq_place" t-esc="payment.cheq_place"/> - <t t-if="payment.cheq_num" t-esc="payment.cheq_num"/> -->
                                            <t t-if="payment.cheq_bank" t-esc="payment.cheq_bank"/> - <t t-if="payment.cheq_num" t-esc="payment.cheq_num"/> -->
                                        </td>
                                        <td class="text-right cheq-line serif-font">
                                            <t t-esc="payment.amount" t-options="{'widget': 'monetary', 'display_currency': payment.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot t-if="page['total_amount']">
                                    <tr>
                                        <td style="visibility: hidden;" />
                                        <td class="serif-font"><b>TOTAL</b></td>
                                        <td class="text-right">
                                            <span style="color: #222 !important;font-weight: bold;" class="serif-font">
                                                <t t-esc="page['total_amount']" t-options="{'widget': 'monetary', 'display_currency': page['currency']}"/>
                                            </span>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-8"> 
                            <b class="serif-font text-bold"> Sommes en toutes lettres </b>
                            <div class="bg-gray">
                                <p class="text-amount" t-esc="o.custom_amount_to_text(page['total_amount'])"/>
                            </div>
                        </div> 
                       <div class="col4 text-right"> 
                            <b class="serif-font text-bold" style="font-size: 16px !important">Signature,</b>
                       </div>
                    </div>
                    <div class="row" style="margin-top: 16px">
                        <div class="col-7"> 
                            <table class="table table-bordered" >
                                <tr> 
                                    <td style="font-size: 14px;" class="text-center serif-font"><b>Nos clients sont priés de BARRER les chèques </b> <br /> 
                                        faisant l'objet de leurs remises
                                    </td>
                                </tr>
                                 <tr> 
                                    <td style="font-size: 14px;" class="text-center serif-font"><b>Si vous désirer garder trace du détail de vos remises, vous pouvez remplir ce borderau en deux exemplaires et consever 
                                    l'un d'eux</b></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-5" style="align-items: end;"> 
                            <b class="float-right serif-font"> B.E.A. 1507</b>
                        </div>
                    </div>
                    <!--END/ -->
                </div>
            </xpath>
        </template>
    </data>
</odoo>